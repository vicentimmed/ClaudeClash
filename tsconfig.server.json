{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["server", "src/sim", "src/net", "src/balance"],
  // client.ts is the browser half of src/net (uses `location`, `WebSocket`);
  // the server only shares protocol.ts and perspective.ts from that folder.
  "exclude": ["src/net/client.ts"]
}
